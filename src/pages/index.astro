---
import Layout from '../layouts/Layout.astro';
import Navhero from '../components/navhero.astro';
---

<Layout titulo="F1 BOX">
	<header class="barra-hero">
		<h1 class="logo-hero">F1 BOX</h1>
		<p class="slogan-hero">Todo sobre la F1</p>
	</header>

	<Navhero></Navhero>
</Layout>

<style>
	.slogan-hero {
		margin-top: 0.5rem;
		margin-bottom: 1rem;
	}

	.barra-hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		background-image: url(/src/assets/img/F1vegashero.jpg);
		background-position-y: 80%;
		background-position-x: right;
		background-size: cover;
		background-repeat: no-repeat;
	}

	.logo-hero {
		margin-top: 1rem;
		margin-bottom: 0.5rem;
	}
</style>