---
import Layout from '../layouts/Layout.astro';
import Navhero from '../components/navhero.astro';
import Noticiahero from '../components/noticiahero.astro';
import Noticiarecientec2 from '../components/noticiarecientec2.astro'
---

<Layout titulo="F1 BOX">
	<header class="barra-hero">
		<h1 class="logo-hero">F1 BOX</h1>
		<p class="slogan-hero">Todo sobre la F1</p>
	</header>

	<Navhero></Navhero>

	<h1 class="noticias-recientes">Noticias recientes</h1>

	<div class="noticia-hero">
		<Noticiahero></Noticiahero>
	</div>
	
	<div class="noticias-anteriores">
		<h1>Noticias anteriores</h1>
	</div>

	<div>
	<Noticiarecientec2></Noticiarecientec2>
	</div>

</Layout>

<style>
	.noticias-recientes {
		display: flex;
		justify-content: center;
		margin-bottom: 2rem;
	}

	.noticias-anteriores {
		display: flex;
		justify-content: center;
	}

	.noticia-hero {
		display: flex;
		justify-content: center;
		align-content: center;
		margin-bottom: 2rem;
	}

	.slogan-hero {
		margin-top: 0.5rem;
		margin-bottom: 1rem;
	}

	.barra-hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-height: 10%;
		background-image: url('/src/assets/img/Blur_F1vegashero.jpg');
    	background-position: right 80%;
    	background-size: cover;
    	background-repeat: no-repeat;
	}

	.logo-hero {
		margin-top: 1rem;
		margin-bottom: 0.5rem;

	}

</style>