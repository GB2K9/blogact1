---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.pubDate <= new Date()))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(1, 6);
---

<section class="noticias-recientes">
  {posts.map((post) => (
    <article class="tarjeta">
      <img src={post.data.cover} alt={post.data.title} class="img" />

      <div class="contenido">
        <a href={`/blog/${post.id}/`} class="titulo">
          <h3>{post.data.title}</h3>
        </a>

        <p class="categoria">Categoria: {post.data.category}</p>

        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleString('es-ES', {
            dateStyle: 'medium',
            timeStyle: 'short',
            timeZone: 'Europe/Madrid',
          })}
        </time>

        <p class="descripcion">{post.data.description}</p>
      </div>
    </article>
  ))}
</section>

<style>
  a:visited {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: red;
  }

  .noticias-recientes {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    width: 60%;
    margin: 2rem auto;
  }

  .tarjeta {
    flex: 1 1 15rem;
    display: flex;
    flex-direction: column;
    border-style: solid;
    border-width: 0.3rem;
    border-color: #1a1a29;
    background-color: #06060e;
    border-radius: 1.5em;
  }

  .img {
    width: 100%;
    height: 10rem;
    object-fit: cover;
    border-top-left-radius: 1.2em;
    border-top-right-radius: 1.2em;
  }

  .contenido {
    display: flex;
    flex-direction: column;
    padding: 0 1em 1em 1em;
  }

  .titulo {
    text-decoration: none;
  }

  .descripcion {
    font-size: 0.9em;
  }
</style>
