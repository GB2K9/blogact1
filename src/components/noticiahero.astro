---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.pubDate <= new Date()))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const post = posts.at(0);
---

{post && (
  <section class="noticia">
    <div class="contenedorimagen">
     <img src={post.data.cover} alt={post.data.title} class="img"/>
    </div>

    <div class="contenido">
      <a href={`/blogact1/blog/${post.id}/`} class="titulo">
        <h2>{post.data.title}</h2>
      </a>

      <h2 class="categoria">
        Categoria: {post.data.category}
      </h2>

        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleString('es-ES', {
                dateStyle: 'medium',
                timeStyle: 'short',
                timeZone: 'Europe/Madrid',
          })}
        </time>

      <p class="descripcion">{post.data.description}</p>
      
    </div>
  </section>
)}
<style>
  a:visited {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: red;
  }

  .descripcion {
    font-size: 1.2em;
  }

  .noticia {
    display: flex;
    flex-direction: row;
    border-style: solid;
    border-width: 0.3rem;
    border-color: #1a1a29;
    background-color: #06060e;
    border-radius: 2em;
    height: 60%;
    width: 60%;
  }

  .contenedorimagen {
    display: flex;
    flex: 1;
    border-bottom-left-radius: 2em;
    border-top-left-radius: 2em;
    object-fit: fill;
  }
  
  .img {
    border-top-left-radius: 2em;
    border-bottom-left-radius: 2em;
  }

  .contenido {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-left: 2em;
    padding-right: 2em;
  }


  .titulo {
    display: flex;
    height: fit-content;
    text-decoration: none;
  }

</style>